# MINT settings. Copy this file to .env (in the MINT folder, next to app.py) and fill it in.
# Настройки MINT. Скопируйте этот файл в .env (в папку MINT, рядом с app.py) и заполните.
# Changes are picked up without a restart; system environment variables take precedence over .env.
# Изменения подхватываются без перезапуска; переменные, заданные в системе, важнее .env.

# ===== Required / Обязательно =====
# OpenAI-compatible LLM API, base URL without /chat/completions
# OpenAI-совместимый API языковой модели — базовый адрес, без /chat/completions
LLM_API_URL=https://llm.example.local/v1
# Full URL of the embeddings endpoint (OpenAI-compatible /embeddings)
# Полный адрес эндпоинта эмбеддингов (OpenAI-совместимый /embeddings)
EMBED_API_URL=https://llm.example.local/v1/embeddings
# API key. Leave empty for local servers without authentication (Ollama, LM Studio, vLLM)
# Ключ доступа. Для локальных серверов без авторизации (Ollama, LM Studio, vLLM) оставьте пустым
LLM_API_KEY=

# Interface language: ru or en (empty: the OS language). Can also be switched in the sidebar.
# Язык интерфейса: ru или en (пусто — язык системы). Переключается и в боковой панели.
MINT_LANG=

# ===== Models / Модели =====
# Default chat model. Empty: the first model listed by the server
# Модель по умолчанию в чате. Пусто — первая из списка, который отдаёт сервер
LLM_MODEL=
EMBED_MODEL=qwen3-embedding-4b

# ===== Optional / Необязательно =====
# Reranker: request {"model","query","documents"} → {"results":[{"index","relevance_score"}]}, e.g. vLLM /v1/rerank.
# Empty: search works without a reranker.
# Реранкер (например, vLLM /v1/rerank). Пусто — поиск работает без реранкера.
RERANK_API_URL=
RERANK_MODEL=bge-reranker-v2-m3

# Separate keys if the services differ (by default LLM_API_KEY is used for all)
# Отдельные ключи, если сервисы разные (по умолчанию для всех берётся LLM_API_KEY)
EMBED_API_KEY=
RERANK_API_KEY=

# Where to keep the knowledge base and logs / Где хранить базу знаний и логи
KB_DIR=~/knowledge_base
LOG_DIR=~/mint_logs

# TLS: path to a corporate CA certificate; SSL_INSECURE=1 disables verification (internal networks only)
# TLS: путь к корпоративному сертификату; SSL_INSECURE=1 отключает проверку (только во внутренней сети)
CA_BUNDLE_PATH=
SSL_INSECURE=

# Your own abbreviation glossary (default: glossary.json next to the program)
# Свой глоссарий сокращений (по умолчанию glossary.json рядом с программой)
GLOSSARY_PATH=
# Your own prompt edits — the "📝 Prompts" page writes them (default: prompts.yaml next to the program)
# Свои правки промптов — их пишет страница «📝 Промпты» (по умолчанию prompts.yaml рядом с программой)
PROMPTS_PATH=
# Settings file (default: config.yaml next to the program) / Файл настроек (по умолчанию config.yaml)
MINT_CONFIG=
# Your own review checklists by document type — the review tab writes them (default: checklists.yaml next to
# the program). If you replace the program folder on every update, keep them outside it: ~/mint_checklists.yaml
# Свои чек-листы аудита по типам документов — их пишет вкладка аудита (по умолчанию checklists.yaml рядом с
# программой). Если при обновлении папка программы заменяется целиком, храните их вне её: ~/mint_checklists.yaml
MINT_CHECKLISTS=

# Turn off model reasoning before answers (1) — a standard parameter for vLLM / SGLang; slow answers and timeouts
# Выключить рассуждения модели перед ответом (1) — стандартный параметр vLLM / SGLang; от медленных ответов и таймаутов
LLM_NO_REASONING=
# Your own LLM request parameters for your gateway, a JSON object, e.g. {"top_p": 0.9}
# Свои параметры запроса к LLM для вашего шлюза, объект JSON, например {"top_p": 0.9}
LLM_EXTRA_BODY=
