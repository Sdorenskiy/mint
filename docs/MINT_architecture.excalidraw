    {
      "id": "mZpXKQNv",
      "type": "text",
      "x": 12,
      "y": 569.5,
      "width": 346.8,
      "height": 616.25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
