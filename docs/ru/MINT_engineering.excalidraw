    {
      "id": "aR5t6Fnn",
      "type": "text",
      "x": 1592,
      "y": 9772.5,
      "width": 765.0,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
