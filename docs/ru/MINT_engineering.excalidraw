      "text": "9. Обращения к сервисам и нагрузка",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "9. Обращения к сервисам и нагрузка",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bNA"
    },
    {
      "id": "o59P4WPj",
      "type": "text",
      "x": 30,
      "y": 15861.75,
      "width": 1203.6,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 783076887,
      "version": 1,
      "versionNonce": 1742391837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792790776894,
      "link": null,
      "locked": false,
      "text": "Для оценки мощностей шлюза под своё число пользователей и объём документов. Все сервисы — OpenAI-совместимый HTTP API.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Для оценки мощностей шлюза под своё число пользователей и объём документов. Все сервисы — OpenAI-совместимый HTTP API.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bNB"
    },
    {
      "id": "Qaaxk4uy",
      "type": "rectangle",
      "x": 30,
      "y": 15901.0,
      "width": 764.0,
      "height": 272.0,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 147394482,
      "version": 1,
      "versionNonce": 1514004282,
