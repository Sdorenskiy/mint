    {
      "id": "MEgp2krG",
      "type": "text",
      "x": 30,
      "y": 0,
      "width": 1392.0,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
