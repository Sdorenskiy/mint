      "boundElements": [],
      "updated": 1792790776894,
      "link": null,
      "locked": false,
      "text": "3. Справочник параметров: определения, значения, ограничения",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Справочник параметров: определения, значения, ограничения",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b58"
    },
    {
      "id": "1N0hg5e2",
      "type": "text",
      "x": 30,
      "y": 3740.0,
      "width": 2305.2,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 65874828,
      "version": 1,
      "versionNonce": 490281628,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792790776894,
      "link": null,
      "locked": false,
      "text": "Единицы: ток. — токены, симв. — символы. «В панели» — диапазон ползунка (если значение из config.yaml больше, ползунок расширяется). config.yaml проверяет только тип значения; защита от несовместимых значений — в коде (колонка\n«Ограничения»).",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Единицы: ток. — токены, симв. — символы. «В панели» — диапазон ползунка (если значение из config.yaml больше, ползунок расширяется). config.yaml проверяет только тип значения; защита от несовместимых значений — в коде (колонка\n«Ограничения»).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b59"
    },
    {
      "id": "ciO3a5zO",
      "type": "rectangle",
      "x": 30,
      "y": 3800.5,
      "width": 1160.0,
      "height": 230.0,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
