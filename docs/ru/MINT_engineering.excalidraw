    {
      "id": "CLcF2KMf",
      "type": "text",
      "x": 42,
      "y": 3812.5,
      "width": 1123.2,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
